#: src/nm_vless/proxyguard.py:144
msgid "System proxy turned off"
msgstr "Системный прокси выключен"

#: src/nm_vless/proxyguard.py:146
#, python-brace-format
msgid ""
"The system proxy {proxy} belongs to another VPN client and would bypass "
"VLESS. It is turned back on when VLESS disconnects."
msgstr ""
"Системный прокси {proxy} принадлежит другому VPN-клиенту, и трафик шёл бы "
"мимо VLESS. Он снова включится, когда VLESS отключится."
