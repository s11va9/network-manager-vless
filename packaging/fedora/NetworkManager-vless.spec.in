# SPDX-License-Identifier: GPL-2.0-or-later
# Generated by build-aux/build-rpm.sh. Do not duplicate the version or Xray pin here.
Name:           NetworkManager-vless
Version:        @VERSION@
Release:        1%{?dist}
Summary:        VLESS VPN client for NetworkManager and GNOME Settings
License:        GPL-2.0-or-later AND MPL-2.0
URL:            https://github.com/s11va9/network-manager-vless
Source0:        network-manager-vless-%{version}.tar.gz
Source1:        xray
Source2:        xray-LICENSE
ExclusiveArch:  x86_64 aarch64

BuildRequires:  gcc
BuildRequires:  gettext
BuildRequires:  gobject-introspection
BuildRequires:  meson >= 1.1
BuildRequires:  ninja-build
BuildRequires:  pkgconfig(libnm) >= 1.24
BuildRequires:  pkgconfig(gtk4) >= 4.6
BuildRequires:  pkgconfig(gmodule-2.0) >= 2.70
BuildRequires:  python3-devel >= 3.11
BuildRequires:  python3-gobject
BuildRequires:  python3-pytest
BuildRequires:  systemd-rpm-macros

Requires:       NetworkManager >= 1.24
Requires:       NetworkManager-libnm >= 1.24
Requires:       python3 >= 3.11
Requires:       python3-gobject
Requires:       gtk4 >= 4.6
Requires:       util-linux
Requires:       systemd
Recommends:     gnome-control-center
Provides:       bundled(xray-core) = @XRAY_VERSION@

# Xray is an upstream binary verified by fetch-xray.sh. Preserve its bytes. Meson
# strips our C libraries during installation; RPM must not post-process Xray.
%global debug_package %{nil}
%global __brp_strip %{nil}
%global __brp_strip_comment_note %{nil}

%description
VLESS VPN client integrated into NetworkManager, GNOME Settings and Quick Settings.
Supports TLS, REALITY, XTLS Vision, XHTTP, WebSocket, HTTPUpgrade and gRPC,
IPv4/IPv6 tunnels and HTTPS subscriptions with automatic updates.
Includes a verified Xray-core build that runs as an unprivileged user.

%prep
%autosetup -n network-manager-vless-%{version}

%build
%meson \
    -Deditor=enabled \
    -Dstrip=true \
    -Dpython=%{__python3} \
    -Dbundled_xray=%{SOURCE1} \
    -Dnm_vpn_dir=%{_prefix}/lib/NetworkManager/VPN \
    -Dsysusers_dir=%{_sysusersdir} \
    -Dsystemd_user_unit_dir=%{_userunitdir} \
    -Ddocdir=%{_docdir}/%{name}
%meson_build

%install
%meson_install
install -Dm0644 %{SOURCE2} %{buildroot}%{_licensedir}/%{name}/xray-LICENSE
install -Dm0644 packaging/fedora/80-network-manager-vless.preset \
    %{buildroot}%{_userpresetdir}/80-network-manager-vless.preset

%check
%meson_test --verbose

%post
systemd-sysusers %{_sysusersdir}/nm-vless.conf
%systemd_user_post nm-vless-subscriptions.timer nm-vless-proxy-guard.service

%preun
%systemd_user_preun nm-vless-subscriptions.timer nm-vless-proxy-guard.service

%postun
%systemd_user_postun nm-vless-subscriptions.timer nm-vless-proxy-guard.service

%files
%license LICENSE
%license %{_licensedir}/%{name}/xray-LICENSE
%{_bindir}/nm-vless
%{_libexecdir}/nm-vless-service
%{_libexecdir}/nm-vless-auth-dialog
%{_libexecdir}/nm-vless/
%{_libdir}/NetworkManager/libnm-vpn-plugin-vless.so
%{_libdir}/NetworkManager/libnm-gtk4-vpn-plugin-vless-editor.so
%{_prefix}/lib/NetworkManager/VPN/nm-vless-service.name
%{_datadir}/nm-vless/
%{_datadir}/dbus-1/system.d/nm-vless-service.conf
%{_datadir}/locale/ru/LC_MESSAGES/NetworkManager-vless.mo
%{_sysusersdir}/nm-vless.conf
%{_userunitdir}/nm-vless-subscriptions.service
%{_userunitdir}/nm-vless-subscriptions.timer
%{_userunitdir}/nm-vless-proxy-guard.service
%{_userpresetdir}/80-network-manager-vless.preset
%doc %{_docdir}/%{name}/

%changelog
* @CHANGELOG_DATE@ NetworkManager-vless contributors - @VERSION@-1
- Native Fedora package with GNOME editor and verified Xray-core.
